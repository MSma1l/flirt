# Adresa API a backendului FLIRT (obligatorie la build de producție, HTTPS).
VITE_API_URL=

# Numele botului Telegram, fără `@` (ex: flirt_md_bot). Din el se construiește
# butonul „Deschide în Telegram" de pe ecranele de stare. Dacă lipsește,
# butonul nu apare — nu există nume implicit hardcodat.
VITE_TELEGRAM_BOT_USERNAME=
