# nginx pentru FLIRT în k8s — TREI nume publice, servite de podul `web`:
#
#   ${DOMAIN}          → proxy către API-ul FastAPI (Service `api`, :8000)
#   ${ADMIN_DOMAIN}    → build-ul static al panoului de admin (SPA React/Vite)
#   ${MINIAPP_DOMAIN}  → build-ul static al Telegram Mini App (SPA Vite)
#
# Port al fostului backend/nginx/nginx.conf (stack-ul docker compose, retras la
# 28.10.2026; acesta e acum SINGURUL config nginx de producție). TOATE regulile de
# securitate de acolo sunt păstrate (antete, CSP per host, /media sandbox +
# MIME, limite de corp, Cache-Control, rate limiting). DIFERENȚE:
#   - TLS NU mai e aici: îl termină Traefik (certificate cert-manager). nginx
#     ascultă HTTP pe 8080, ca non-root. Fără :443, fără certbot/ACME, fără
#     redirect 301 (redirect-ul HTTP→HTTPS e treaba lui Traefik).
#   - HSTS se trimite în continuare: tot traficul care ajunge la utilizator e HTTPS.
#   - IP-ul clientului vine din X-Forwarded-For pus de Traefik (`real_ip_*`).
#   - Schema (https) vine din X-Forwarded-Proto pus de Traefik ($flirt_fwd_proto).
#   - `/nginx-health` pe serverul implicit, pentru probele kubelet.
#
# ┌─ ȘABLON ─────────────────────────────────────────────────────────────────────┐
# │ `${DOMAIN}`, `${ADMIN_DOMAIN}`, `${MINIAPP_DOMAIN}` sunt înlocuite la pornire │
# │ de flirt-web-entrypoint.sh (envsubst cu listă FIXĂ — variabilele nginx gen    │
# │ $host rămân neatinse). Rezultatul: /tmp/nginx/flirt.conf, inclus în `http`.   │
# └──────────────────────────────────────────────────────────────────────────────┘

# --------------------------------------------------------------------------- #
# UPSTREAM API. În vechiul compose foloseam `resolver 127.0.0.11` + variabilă, pentru că
# IP-ul containerului `api` se schimba la fiecare restart. În k8s numele `api`
# e un Service cu ClusterIP STABIL (nu se schimbă când podurile mor/repornesc;
# kube-proxy alege un pod sănătos), deci un `upstream` clasic e corect și ne dă
# keepalive. Numele se rezolvă la pornire prin /etc/resolv.conf (search domain
# flirt.svc.cluster.local). Doar dacă Service-ul `api` e ȘTERS și recreat (alt
# ClusterIP) trebuie `kubectl -n flirt rollout restart deploy/web`.
# --------------------------------------------------------------------------- #
upstream flirt_api {
    server api:8000;
    keepalive 32;
}

server_tokens off;

# --------------------------------------------------------------------------- #
# IP-UL REAL AL CLIENTULUI. Conexiunea vine de la podul Traefik (rețeaua de
# poduri k3s, 10.42.0.0/16). Avem încredere în X-Forwarded-For DOAR de acolo;
# `real_ip_recursive` ia prima adresă din dreapta care NU e în rețeaua de poduri
# → un X-Forwarded-For inventat de client (stânga listei) e ignorat.
# Efect: rate limiting-ul ($binary_remote_addr) și jurnalul folosesc IP-ul real.
# ⚠️  Presupune că Traefik vede IP-ul real (Service cu externalTrafficPolicy:
#     Local); altfel TOȚI clienții ar avea același IP și ar împărți limitele.
# --------------------------------------------------------------------------- #
set_real_ip_from 10.42.0.0/16;
real_ip_header X-Forwarded-For;
real_ip_recursive on;

# Schema reală pentru API. Traefik pune X-Forwarded-Proto: https. Acceptăm DOAR
# valoarea `https`; orice altceva (lipsă, gunoi) → schema conexiunii (http).
map $http_x_forwarded_proto $flirt_fwd_proto {
    default  $scheme;
    https    https;
}

# --------------------------------------------------------------------------- #
# COMPRESIE GZIP — pentru TOATE serverele. JSON-ul API-ului și bundle-urile
# JS/CSS se comprimă de 4-8 ori. Pozele/video-urile NU (deja comprimate).
# O singură compresie, aici (fără GZipMiddleware în FastAPI).
# --------------------------------------------------------------------------- #
gzip on;
gzip_vary on;
gzip_proxied any;
gzip_comp_level 5;
gzip_min_length 1024;
gzip_types text/plain text/css application/json application/javascript text/javascript image/svg+xml application/manifest+json;

# --------------------------------------------------------------------------- #
# JURNAL DE ACCES CU IP TRUNCHIAT (Politica de confidențialitate, secț. 10).
# IPv4 → ultimul octet 0; IPv6 → primele 3 grupuri (/48). Fără query string
# (`$uri`, nu `$request`) și fără Referer. Limitarea de rată folosește IP-ul
# complet ($binary_remote_addr) — doar în memorie. Log-urile merg pe stdout
# (kubectl logs); retenția o dă rotația kubelet/containerd.
# --------------------------------------------------------------------------- #
map $remote_addr $flirt_anon_ip {
    ~^(?P<v4>\d+\.\d+\.\d+)\.\d+$          $v4.0;
    ~^(?P<v6>[0-9A-Fa-f]*:[0-9A-Fa-f]*:[0-9A-Fa-f]*):  $v6::;
    default                                      0.0.0.0;
}
log_format flirt_anon '$flirt_anon_ip [$time_local] "$request_method $uri $server_protocol" '
                      '$status $body_bytes_sent $request_time "$http_user_agent" $request_id';

# --------------------------------------------------------------------------- #
# RATE LIMITING la marginea rețelei (identic cu vechiul compose; motivarea
# pragurilor: istoricul git al fostului backend/nginx/nginx.conf). Cheia = IP-ul REAL (după real_ip).
# ATENȚIE: zonele sunt PER POD. Cu `web` la N replici, limita efectivă e ~N×.
# --------------------------------------------------------------------------- #
limit_req_zone $binary_remote_addr zone=flirt_general:10m rate=20r/s;

# Pentru OPTIONS cheia e GOALĂ → nginx nu numără preflight-urile CORS.
map $request_method $flirt_auth_key {
    default  $binary_remote_addr;
    OPTIONS  "";
}

# Login cu parolă: rar și scump de ghicit → strict.
limit_req_zone $flirt_auth_key zone=flirt_auth:10m rate=5r/m;
# Autentificarea Telegram: refăcută la FIECARE deschidere a Mini App-ului.
limit_req_zone $flirt_auth_key zone=flirt_tg_auth:10m rate=60r/m;
# Sesiune (/auth/me, /auth/refresh): bătăile de inimă ale unei sesiuni; CGNAT.
limit_req_zone $flirt_auth_key zone=flirt_session:10m rate=120r/m;
# Media: un feed încarcă zeci de poze dintr-o dată.
limit_req_zone $binary_remote_addr zone=flirt_media:10m rate=100r/s;
limit_req_status 429;

# --------------------------------------------------------------------------- #
# DEFAULT — orice Host care nu e unul dintre numele noastre primește 444
# (conexiune închisă fără răspuns). Aici ajung și probele kubelet (Host = IP-ul
# podului) → `/nginx-health` răspunde 200 DOAR aici, fără log.
# --------------------------------------------------------------------------- #
server {
    listen 8080 default_server;
    server_name _;
    access_log /dev/stdout flirt_anon;

    location = /nginx-health {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    location / {
        return 444;
    }
}

# --------------------------------------------------------------------------- #
# API — ${DOMAIN}. Tot traficul aplicației mobile (inclusiv JWT) trece pe aici.
# --------------------------------------------------------------------------- #
server {
    listen 8080;
    server_name ${DOMAIN};
    access_log /dev/stdout flirt_anon;

    # Corpul cererii: 1 MB IMPLICIT. Limita mare (55m) există DOAR în
    # `location`-ul de upload de mai jos (multipart).
    client_max_body_size 1m;

    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;
    add_header Referrer-Policy no-referrer always;
    add_header Strict-Transport-Security "max-age=63072000; includeSubDomains; preload" always;

    # Liveness + readiness (/health, /health/ready) prin proxy. Limitat (public;
    # /health/ready atinge DB + Redis). Probele kubelet lovesc DIRECT api:8000,
    # nu trec pe aici. Fără access log.
    location /health {
        limit_req zone=flirt_general burst=10 nodelay;
        include /etc/nginx/snippets/proxy-api.conf;
        access_log off;
    }

    # ----------------------------------------------------------------------- #
    # MEDIA — servită DIRECT de nginx din PVC-ul media (montat read-only la
    # /var/www/media), NU prin Python. Chei IMUABILE (`<prefix>/<id>/<uuid4>.<ext>`)
    # → un an de cache cu `immutable`. Path-ul = cel din STORAGE_BASE_URL (/media).
    # ----------------------------------------------------------------------- #

    # DOVEZILE DE PLATĂ nu sunt publice (doar prin
    # /api/v1/ticket-requests/*/payment-proof). 404, nu 403. nginx normalizează
    # URI-ul înainte de potrivire → nu se poate ocoli cu `../`.
    location = /media/ticket-proofs {
        return 404;
    }
    location /media/ticket-proofs/ {
        return 404;
    }

    location /media/ {
        limit_req zone=flirt_media burst=200 nodelay;

        root /var/www;
        try_files $uri =404;
        autoindex off;

        # MIME explicit pentru TOATE extensiile generate de server: mime.types
        # nu știe .weba/.aac și dă .m4a ca audio/x-m4a (WebView-ul iOS refuză).
        # Range (206) e implicit la fișiere statice — iOS îl cere pentru audio/video.
        types {
            image/jpeg  jpg jpeg;
            image/png   png;
            image/webp  webp;
            image/gif   gif;
            image/avif  avif;
            video/mp4   mp4 m4v;
            video/quicktime mov;
            video/webm  webm;
            audio/mp4   m4a;
            audio/aac   aac;
            audio/mpeg  mp3;
            audio/ogg   ogg opus;
            audio/webm  weba;
        }
        default_type application/octet-stream;

        # Un SINGUR Cache-Control (fără `expires`), FĂRĂ `always` (404 necachat).
        add_header Cache-Control "public, max-age=31536000, immutable";
        # `add_header` aici anulează moștenirea de la server → le repetăm.
        add_header X-Content-Type-Options nosniff always;
        add_header X-Frame-Options DENY always;
        add_header Referrer-Policy no-referrer always;
        add_header Strict-Transport-Security "max-age=63072000; includeSubDomains; preload" always;
        # Conținut încărcat de UTILIZATORI pe originea API-ului: izolat dacă
        # vreodată ar fi interpretat ca document (SVG/HTML strecurat).
        add_header Content-Security-Policy "default-src 'none'; sandbox" always;

        open_file_cache max=5000 inactive=60s;
        access_log off;
    }

    # Autentificare Telegram (potrivire EXACTĂ, prioritară față de /api/v1/auth/).
    location = /api/v1/auth/telegram {
        limit_req zone=flirt_tg_auth burst=30 nodelay;
        include /etc/nginx/snippets/proxy-api.conf;
    }

    # Rutele de SESIUNE ale unui utilizator deja autentificat.
    location = /api/v1/auth/me {
        limit_req zone=flirt_session burst=120 nodelay;
        include /etc/nginx/snippets/proxy-api.conf;
    }

    location = /api/v1/auth/refresh {
        limit_req zone=flirt_session burst=120 nodelay;
        include /etc/nginx/snippets/proxy-api.conf;
    }

    # Acreditări: login cu parolă, înregistrare, Google/Apple → 5r/m, burst 10.
    location /api/v1/auth/ {
        limit_req zone=flirt_auth burst=10 nodelay;
        include /etc/nginx/snippets/proxy-api.conf;
    }

    # UPLOAD-URI (multipart) — singurele rute cu corp mare (lista EXACTĂ din
    # routerele app/api/v1/**). 55m = 50 MB video
    # + overhead multipart; limita fină per tip rămâne în aplicație.
    # Regex ANCORAT `^/api/v1/...$`: nu poate potrivi /media/... (nu ocolește
    # blocarea /media/ticket-proofs/).
    location ~ ^/api/v1/(profiles/(photos|verify-face)|stories/media|chats/[^/]+/attachments|(ticket-requests|ticket-orders)/[^/]+/payment-proof|admin/(ads/media|events/cover|payment-settings/mia-qr))$ {
        limit_req zone=flirt_general burst=40 nodelay;
        client_max_body_size 55m;
        include /etc/nginx/snippets/proxy-api.conf;
    }

    location / {
        limit_req zone=flirt_general burst=40 nodelay;
        include /etc/nginx/snippets/proxy-api.conf;
    }
}

# --------------------------------------------------------------------------- #
# ADMIN — ${ADMIN_DOMAIN}. DOAR fișierele statice ale panoului (build în imagine,
# /var/www/admin). Panoul vorbește cu API-ul pe https://${DOMAIN} (cross-origin;
# CORS_ORIGINS trebuie să conțină https://${ADMIN_DOMAIN}). NU proxyăm /api/ aici.
# --------------------------------------------------------------------------- #
server {
    listen 8080;
    server_name ${ADMIN_DOMAIN};
    access_log /dev/stdout flirt_anon;

    root /var/www/admin;
    index index.html;

    limit_req zone=flirt_general burst=40 nodelay;

    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;
    add_header Referrer-Policy no-referrer always;
    add_header Strict-Transport-Security "max-age=63072000; includeSubDomains; preload" always;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data:; connect-src 'self' https://${DOMAIN}; frame-ancestors 'none'; base-uri 'self'; form-action 'self'" always;

    # ⚠️  `add_header` într-un `location` ANULEAZĂ COMPLET antetele serverului →
    # le repetăm EXPLICIT în fiecare location cu `add_header`.

    # Asset-uri Vite cu hash → cache agresiv. Cache-Control FĂRĂ `always`.
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        add_header X-Content-Type-Options nosniff always;
        add_header X-Frame-Options DENY always;
        add_header Referrer-Policy no-referrer always;
        add_header Strict-Transport-Security "max-age=63072000; includeSubDomains; preload" always;
        add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data:; connect-src 'self' https://${DOMAIN}; frame-ancestors 'none'; base-uri 'self'; form-action 'self'" always;
        try_files $uri =404;
    }

    # index.html NU se cachează (altfel build vechi → asset-uri inexistente).
    location = /index.html {
        add_header Cache-Control "no-store" always;
        add_header X-Content-Type-Options nosniff always;
        add_header X-Frame-Options DENY always;
        add_header Referrer-Policy no-referrer always;
        add_header Strict-Transport-Security "max-age=63072000; includeSubDomains; preload" always;
        add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data:; connect-src 'self' https://${DOMAIN}; frame-ancestors 'none'; base-uri 'self'; form-action 'self'" always;
    }

    # Fallback SPA: refresh pe o rută internă (/users, /reports...) → index.html.
    location / {
        try_files $uri $uri/ /index.html;
    }
}

# --------------------------------------------------------------------------- #
# MINI APP — ${MINIAPP_DOMAIN}. DOAR fișierele statice ale Telegram Mini App-ului
# (/var/www/miniapp). Vorbește cu API-ul pe https://${DOMAIN} (cross-origin).
# Dacă MINIAPP_DOMAIN e gol, entrypoint-ul pune santinela `miniapp.localhost`
# (blocul rămâne valid; traficul real nu ajunge pe el).
#
# CSP diferit de admin (motivarea completă: istoricul git al fostului backend/nginx/nginx.conf):
# frame-ancestors = originile Telegram (Mini App-ul e încadrat), script-src +
# telegram.org (SDK-ul oficial), img-src/media-src https: + blob:. FĂRĂ
# X-Frame-Options (DENY ar bloca iframe-ul Telegram).
# --------------------------------------------------------------------------- #
server {
    listen 8080;
    server_name ${MINIAPP_DOMAIN};
    access_log /dev/stdout flirt_anon;

    root /var/www/miniapp;
    index index.html;

    limit_req zone=flirt_general burst=40 nodelay;

    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy no-referrer always;
    add_header Strict-Transport-Security "max-age=63072000; includeSubDomains; preload" always;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self' https://telegram.org; style-src 'self' 'unsafe-inline'; img-src 'self' https: data: blob:; media-src 'self' https: blob:; font-src 'self' data:; connect-src 'self' https://${DOMAIN}; frame-ancestors https://web.telegram.org https://telegram.org; base-uri 'self'; form-action 'self'" always;
    # Camera + microfon DOAR pentru originea proprie; restul interzis.
    add_header Permissions-Policy "camera=(self), microphone=(self), geolocation=(), payment=(), usb=(), serial=(), bluetooth=(), hid=(), midi=(), magnetometer=(), gyroscope=(), accelerometer=(), display-capture=(), browsing-topics=()" always;

    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        add_header X-Content-Type-Options nosniff always;
        add_header Referrer-Policy no-referrer always;
        add_header Strict-Transport-Security "max-age=63072000; includeSubDomains; preload" always;
        add_header Content-Security-Policy "default-src 'self'; script-src 'self' https://telegram.org; style-src 'self' 'unsafe-inline'; img-src 'self' https: data: blob:; media-src 'self' https: blob:; font-src 'self' data:; connect-src 'self' https://${DOMAIN}; frame-ancestors https://web.telegram.org https://telegram.org; base-uri 'self'; form-action 'self'" always;
        add_header Permissions-Policy "camera=(self), microphone=(self), geolocation=(), payment=(), usb=(), serial=(), bluetooth=(), hid=(), midi=(), magnetometer=(), gyroscope=(), accelerometer=(), display-capture=(), browsing-topics=()" always;
        try_files $uri =404;
    }

    # index.html NU se cachează: Telegram ține Mini App-ul deschis mult timp.
    location = /index.html {
        add_header Cache-Control "no-store" always;
        add_header X-Content-Type-Options nosniff always;
        add_header Referrer-Policy no-referrer always;
        add_header Strict-Transport-Security "max-age=63072000; includeSubDomains; preload" always;
        add_header Content-Security-Policy "default-src 'self'; script-src 'self' https://telegram.org; style-src 'self' 'unsafe-inline'; img-src 'self' https: data: blob:; media-src 'self' https: blob:; font-src 'self' data:; connect-src 'self' https://${DOMAIN}; frame-ancestors https://web.telegram.org https://telegram.org; base-uri 'self'; form-action 'self'" always;
        add_header Permissions-Policy "camera=(self), microphone=(self), geolocation=(), payment=(), usb=(), serial=(), bluetooth=(), hid=(), midi=(), magnetometer=(), gyroscope=(), accelerometer=(), display-capture=(), browsing-topics=()" always;
    }

    # Fallback SPA (deep-link cu ?tgWebAppStartParam=... → index.html).
    location / {
        try_files $uri $uri/ /index.html;
    }
}
